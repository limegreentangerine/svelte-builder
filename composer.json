{
    "name": "limegreentangerine/svelte-builder",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Limegreentangerine\\SvelteBuilder\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Lee Jones",
            "email": "mail@leejones.me.uk"
        }
    ],
    "bin": [
        "bin/sb-post-install",
        "bin/build-svelte-component"
    ],
    "scripts": {
        "post-install-cmd": [
            "./vendor/bin/sb-post-install"
        ]
    },
    "require": {
        "prolificjones/npm-plugin-installer": "^0.0.1"
    },
    "config": {
        "allow-plugins": {
            "prolificjones/npm-plugin-installer": true
        }
    },
    "extra": {
        "npm-installer": {
            "manager": "npm",
            "dev-packages": [
                "vite",
                "typescript"
            ],
            "package-json": {
                "scripts": {
                    "build": "vite build"
                },
                "browserslist": [
                    "defaults"
                ]
            }
        }
    }
}
