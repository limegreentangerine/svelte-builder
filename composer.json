{
    "name": "limegreentangerine/svelte-builder",
    "type": "composer-plugin",
    "license": "MIT",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Limegreentangerine\\SvelteBuilder\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Lee Jones",
            "email": "mail@leejones.me.uk"
        }
    ],
    "bin": [
        "bin/build-svelte-component"
    ],
    "require": {
        "composer-plugin-api": "^2.0",
        "prolificjones/npm-plugin-installer": "^0.0.3"
    },
    "extra": {
        "class": "Limegreentangerine\\SvelteBuilder\\Installer",
        "npm-plugin-installer": {
            "manager": "npm",
            "package-json": {
                "scripts": {
                    "build": "vite build",
                    "dev": "vite"
                },
                "engines": {
                    "node": "^24.15"
                }
            }
        }
    },
    "config": {
        "allow-plugins": {
            "prolificjones/npm-plugin-installer": true
        }
    }
}
