#!/usr/bin/env php
<?php

declare(strict_types=1);

$projectRoot = getcwd();
$composerPath = realpath(__DIR__ . '/..');

// install required npm packages
$commands = [
    [
        'npm',
        'install',
        '--loglevel=error',
        '--save-dev',
		'eslint-plugin-svelte',
		'globals',
		'prettier',
		'prettier-plugin-svelte',
		'svelte',
		'svelte-check',
		'typescript',
		'typescript-eslint',
		'vite',
    ]
];

echo "Installing npm packages..." . PHP_EOL;

foreach ($commands as $command) {
    $process = proc_open(
        $command,
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes,
        $projectRoot
    );

    if (!is_resource($process)) {
        throw new RuntimeException('Unable to start npm.');
    }

    $exitCode = proc_close($process);
    if ($exitCode !== 0) {
        exit($exitCode);
    }
}

echo "Installing svelte resources..." . PHP_EOL;

$resourcesFolder = $composerPath . DIRECTORY_SEPARATOR . 'resources/root';
$filesToInstall = [
    'tsconfig.json',
    'svelte.config.js',
    'svelte.d.ts'
];

foreach ($filesToInstall as $fti) {
    $source = $resourcesFolder . DIRECTORY_SEPARATOR . $fti;
    $destination = $projectRoot . DIRECTORY_SEPARATOR . $fti;

    if (file_exists($source) && !file_exists($destination)) {
        if (!copy($source, $destination)) {
            fwrite(STDERR, "Unable to copy: {$source}\n");
        } else {
            unlink($source);
        }
    } else {
        echo "{$destination} exists -- (ignored)\n";
    }
}

echo "Configuring svelte build scripts..." . PHP_EOL;

$packageJsonPath = $projectRoot . DIRECTORY_SEPARATOR . 'package.json';

// Read the existing package.json
if (!file_exists($packageJsonPath)) {
    echo "package.json not found at {$packageJsonPath}" . PHP_EOL;
    return;
}

$packageJson = json_decode(file_get_contents($packageJsonPath), true);

if (!is_array($packageJson)) {
    echo "Failed to parse package.json" . PHP_EOL;
    return;
}

// Ensure scripts section exists
if (!isset($packageJson['scripts'])) {
    $packageJson['scripts'] = [];
}

// Add or modify scripts
$packageJson['scripts']['dev'] = 'vite';
$packageJson['scripts']['build'] = 'vite build';
$packageJson['scripts']['lint'] = 'eslint src --fix';
$packageJson['scripts']['check'] = 'svelte-check --tsconfig ./tsconfig.json';

// Write it back with nice formatting
file_put_contents(
    $packageJsonPath,
    json_encode($packageJson, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL
);

echo "Updated package.json" . PHP_EOL;
